{
  "title": "Cluster Health",
  "schemaVersion": 38,
  "panels": [
    {
      "type": "stat",
      "title": "Ready Nodes",
      "targets": [
        {
          "expr": "count(kube_node_status_condition{condition='Ready',status='true'})"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Running Pods",
      "targets": [
        {
          "expr": "count(kube_pod_status_phase{phase='Running'})"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Failed Pods",
      "targets": [
        {
          "expr": "count(kube_pod_status_phase{phase='Failed'})"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cluster CPU",
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total[5m]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cluster Memory",
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes)"
        }
      ]
    },
    {
      "type": "barchart",
      "title": "Top 5 CPU Pods",
      "targets": [
        {
          "expr": "topk(5,sum(rate(container_cpu_usage_seconds_total[5m])) by (pod))"
        }
      ]
    },
    {
      "type": "barchart",
      "title": "Top 5 Memory Pods",
      "targets": [
        {
          "expr": "topk(5,sum(container_memory_working_set_bytes) by (pod))"
        }
      ]
    }
  ]
}